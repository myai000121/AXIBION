{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronics or technology item available for sale on AXIBION",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "images": { "type": "array" },
        "specifications": { "type": "object" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "stock", "category", "brand"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with Cash on Delivery terms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 1000 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash on Delivery"] },
        "status": {
          "type": "string",
          "enum": ["Order Placed", "Confirmed", "Processing", "Shipped", "Out for Delivery", "Delivered", "Cancelled"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "customerName", "email", "phone", "address", "city", "items", "totalAmount", "paymentMethod", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "slug": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "slug"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional homepage banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 250 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "link": { "type": "string", "maxLength": 250 },
        "active": { "type": "boolean" },
        "badge": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "title", "active"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Site-wide configuration and metadata",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "supportEmail": { "type": "string" },
        "supportPhone": { "type": "string" },
        "notice": { "type": "string" },
        "freeShippingThreshold": { "type": "number" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Administrative audit and event logging",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "adminEmail", "action", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catalog of electronics and tech products"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with Cash on Delivery details"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "List of catalog categories"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage promotional slides"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Global website configuration settings"
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Administrator activity logs"
    }
  }
}
